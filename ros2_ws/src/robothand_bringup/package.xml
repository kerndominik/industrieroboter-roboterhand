<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robothand_bringup</name>
  <version>1.0.0</version>
  <description>Launch files that start the complete robot hand system.</description>
  <maintainer email="robothand@todo.todo">Robothand Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robothand_description</exec_depend>
  <exec_depend>robothand_gui</exec_depend>
  <exec_depend>robothand_interface</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
