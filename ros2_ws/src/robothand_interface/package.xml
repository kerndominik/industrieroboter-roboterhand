<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robothand_interface</name>
  <version>1.0.0</version>
  <description>
    Hardware interface of the robot hand: subscribes to ROS 2 command topics,
    drives the finger servos on an Arduino Mega 2560 / ESP32 over USB serial,
    publishes joint_states and strain gauge measurements.
  </description>
  <maintainer email="robothand@todo.todo">Robothand Team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>robothand_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
