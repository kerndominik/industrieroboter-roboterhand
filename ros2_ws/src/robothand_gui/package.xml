<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robothand_gui</name>
  <version>1.0.0</version>
  <description>
    Qt user interface of the robot hand: finger control with grasp presets and
    motion sequences, live plots of joint angles and strain gauges, and the
    Denavit-Hartenberg forward kinematics compared with TF.
  </description>
  <maintainer email="robothand@todo.todo">Robothand Team</maintainer>
  <license>MIT</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robothand_description</exec_depend>
  <exec_depend>robothand_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>urdfdom_py</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
