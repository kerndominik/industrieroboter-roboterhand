<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robothand_description</name>
  <version>1.0.0</version>
  <description>
    URDF model (xacro + STL meshes from the CAD model) and Denavit-Hartenberg
    parameters of the robot hand. Launches robot_state_publisher to publish the
    TF transforms and can visualize the hand in RViz2.
  </description>
  <maintainer email="robothand@todo.todo">Robothand Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>urdfdom_py</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
